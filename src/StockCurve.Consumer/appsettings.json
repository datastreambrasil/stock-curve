{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:19092",
    "Topic": "b3.quotes",
    "DeadLetterTopic": "b3.quotes.dlq",
    "GroupId": "stock-curve-chart",
    "AutoOffsetReset": "earliest",
    "HistorySize": 500,
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    }
  }
}
