{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "b3.quotes",
    "EnableIdempotence": true,
    "LingerMs": 20,
    "BatchSize": 1000000,
    "CompressionType": "lz4"
  }
}
