{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:19092",
    "Topic": "b3.quotes",
    "EnableIdempotence": true,
    "LingerMs": 20,
    "BatchSize": 1000000,
    "CompressionType": "lz4",
    "SchemaRegistry": {
      "Url": "http://localhost:8081",
      "AutoRegisterSchemas": true
    }
  }
}
